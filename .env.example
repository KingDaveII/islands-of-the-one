# Server
PORT=2567
HOST=0.0.0.0
# Postgres. Leave unset to use an embedded PGlite database instead.
DATABASE_URL=postgres://game:game@localhost:5432/game
# Optional: persist PGlite to disk (only used when DATABASE_URL is unset).
# PGLITE_DIR=.pglite
# Set to skip applying migrations on server start.
# SKIP_MIGRATIONS=1

# Server build id reported by /health (set by the Docker build).
# APP_VERSION=dev

# Client (build time). Dev default: ws(s)://<page host>:2567. Production builds
# default to the page's own origin.
# VITE_SERVER_URL=ws://localhost:2567
